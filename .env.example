# ── Broker (Cloud Run) environment variables ──────────────────────────────────

# Your GCP project ID
PROJECT_ID=your-gcp-project-id

# OAuth 2.0 Client ID (Web application type) from GCP Console → APIs & Services → Credentials
CLIENT_ID=your-client-id.apps.googleusercontent.com

# Full callback URL — must match an Authorised Redirect URI in your OAuth client config
# Format: https://YOUR-CLOUD-RUN-SERVICE-URL/auth/callback
REDIRECT_URI=https://your-service-url.run.app/auth/callback

# Secret Manager secret ID where the OAuth client secret is stored
# Default: oauth-client-secret
CLIENT_SECRET_ID=oauth-client-secret

# Shared secret between broker and agent — generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
TOKEN_SERVICE_SECRET=generate-a-strong-random-value


# ── Agent (Reasoning Engine) environment variables ────────────────────────────

# Base URL of the deployed Cloud Run broker (no trailing slash)
AUTH_SERVICE_URL=https://your-service-url.run.app

# Same TOKEN_SERVICE_SECRET as above
TOKEN_SERVICE_SECRET=generate-a-strong-random-value

# API Executable deployment ID from Apps Script → Deploy → Manage deployments
# Starts with AKfy...
SCRIPT_ID=AKfy...your-deployment-id
